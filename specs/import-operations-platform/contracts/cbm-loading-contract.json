{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CBMLoadingContract",
  "type": "object",
  "properties": {
    "evaluation_request": {
      "type": "object",
      "required": ["total_cbm", "total_gross_weight_kg", "container_type"],
      "properties": {
        "total_cbm": { "type": "number", "minimum": 0 },
        "total_gross_weight_kg": { "type": "number", "minimum": 0 },
        "max_pkg_w_cm": { "type": "number", "default": 0 },
        "max_pkg_h_cm": { "type": "number", "default": 0 },
        "container_type": { "type": "string", "enum": ["20GP", "40GP", "40HC", "45HC"] }
      }
    },
    "evaluation_response": {
      "type": "object",
      "required": ["status", "space_utilization_pct", "payload_utilization_pct", "door_clearance_passed"],
      "properties": {
        "status": { "type": "string", "enum": ["Fit", "Partial Fit", "Overweight", "Oversized"] },
        "status_message": { "type": "string" },
        "space_utilization_pct": { "type": "number" },
        "payload_utilization_pct": { "type": "number" },
        "door_clearance_passed": { "type": "boolean" }
      }
    }
  }
}
